#!/bin/sh
# Local pre-push compile guard.
# Enable once per clone: git config core.hooksPath .githooks
# Skip compile only:     SKIP_UNITY_COMPILE=1 git push

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
CHECK="$ROOT/scripts/check-compile.sh"

if [ -x "$CHECK" ]; then
  "$CHECK" || {
    echo >&2 "pre-push: compile check failed (SKIP_UNITY_COMPILE=1 to bypass locally)."
    exit 1
  }
else
  echo >&2 "pre-push: missing $CHECK — run compile check manually (see AGENTS.md)."
  exit 1
fi
